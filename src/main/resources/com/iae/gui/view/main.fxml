<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.input.KeyCombination?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iae.gui.controller.MainController">

    <top>
        <VBox>
            <MenuBar>
                <menus>
                    <Menu text="File">
                        <items>
                            <MenuItem fx:id="menuNewProject" text="New Project" onAction="#onNewProject">
                                <accelerator>
                                    <KeyCombination fx:value="Ctrl+N"/>
                                </accelerator>
                            </MenuItem>
                            <MenuItem fx:id="menuOpenProject" text="Open Project..." onAction="#onOpenProject">
                                <accelerator>
                                    <KeyCombination fx:value="Ctrl+O"/>
                                </accelerator>
                            </MenuItem>
                            <MenuItem fx:id="menuSaveProject" text="Save Project" disable="true" onAction="#onSaveProject">
                                <accelerator>
                                    <KeyCombination fx:value="Ctrl+S"/>
                                </accelerator>
                            </MenuItem>
                            <MenuItem fx:id="menuSaveProjectAs" text="Save Project As..." disable="true" onAction="#onSaveProjectAs"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="menuExit" text="Exit" onAction="#onExit">
                                <accelerator>
                                    <KeyCombination fx:value="Alt+F4"/>
                                </accelerator>
                            </MenuItem>
                        </items>
                    </Menu>
                    <Menu text="Edit">
                        <items>
                            <MenuItem fx:id="menuEditProject" text="Edit Project..." disable="true" onAction="#onEditProject"/>
                            <MenuItem fx:id="menuManageConfigs" text="Manage Configurations..." onAction="#onManageConfigurations"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="menuImportConfig" text="Import Configuration..." onAction="#onImportConfiguration"/>
                            <MenuItem fx:id="menuExportConfig" text="Export Configuration..." onAction="#onExportConfiguration"/>
                            <MenuItem fx:id="menuExportAllConfigs" text="Export All Configurations..." onAction="#onExportAllConfigurations"/>
                        </items>
                    </Menu>
                    <Menu text="Help">
                        <items>
                            <MenuItem fx:id="menuManual" text="Manual" onAction="#onManual">
                                <accelerator>
                                    <KeyCombination fx:value="F1"/>
                                </accelerator>
                            </MenuItem>
                            <MenuItem fx:id="menuAbout" text="About IAE" onAction="#onAbout"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <ToolBar>
                <items>
                    <Button fx:id="runButton" text="Run" disable="true" onAction="#onRunClicked"
                            style="-fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ProgressBar fx:id="progressBar" prefWidth="200" progress="0"/>
                    <Label fx:id="progressLabel" text="0 / 0 submissions"/>
                </items>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.3">

            <!-- Left: Project details + Run Summary -->
            <VBox spacing="8">
                <padding>
                    <Insets top="8" right="8" bottom="8" left="8"/>
                </padding>
                <Label text="PROJECT" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                <GridPane hgap="8" vgap="4">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="115"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           style="-fx-text-fill: #666666;"/>
                    <Label fx:id="lblProjectName" text="—" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Configuration:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           style="-fx-text-fill: #666666;"/>
                    <Label fx:id="lblConfigName" text="—" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Submissions Dir:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                           style="-fx-text-fill: #666666;"/>
                    <Label fx:id="lblSubsDir" text="—" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Arguments:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                           style="-fx-text-fill: #666666;"/>
                    <Label fx:id="lblArgs" text="—" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Expected Output:" GridPane.rowIndex="4" GridPane.columnIndex="0"
                           style="-fx-text-fill: #666666;"/>
                    <Label fx:id="lblExpected" text="—" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <Label text="RUN SUMMARY"
                       style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 8 0 0 0;"/>
                <GridPane hgap="8" vgap="4">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="115"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Total:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           style="-fx-text-fill: #666666;"/>
                    <Label fx:id="lblTotal" text="0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Passed:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           style="-fx-text-fill: #666666;"/>
                    <Label fx:id="lblPassed" text="0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Failed:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                           style="-fx-text-fill: #666666;"/>
                    <Label fx:id="lblFailed" text="0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Pending:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                           style="-fx-text-fill: #666666;"/>
                    <Label fx:id="lblPending" text="0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <!-- Right: Results table -->
            <VBox spacing="8">
                <padding>
                    <Insets top="8" right="8" bottom="8" left="8"/>
                </padding>
                <Label text="RESULTS" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colStudentId" text="Student ID" prefWidth="105"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="105"/>
                        <TableColumn fx:id="colCapturedOutput" text="Captured Output" prefWidth="245"/>
                        <TableColumn fx:id="colErrorMessage" text="Error / Mismatch" prefWidth="245"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

        </SplitPane>
    </center>

    <bottom>
        <Label fx:id="statusBar" text="Ready"
               style="-fx-padding: 4 8 4 8; -fx-background-color: #f0f0f0; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;"/>
    </bottom>

</BorderPane>
