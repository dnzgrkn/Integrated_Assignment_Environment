<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.iae.gui.controller.ResultsViewController"
      prefWidth="820" prefHeight="600"
      style="-fx-background-color: white;">

    <HBox style="-fx-background-color: #3c3f41; -fx-padding: 12 16 12 16;"
          alignment="CENTER_LEFT" spacing="16">
        <Label text="Results —"
               style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;"/>
        <Label fx:id="projectNameLabel"
               text="(project name)"
               style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
    </HBox>

    <ToolBar>
        <Label text="■" style="-fx-text-fill: #28a745; -fx-font-size: 14px;"/>
        <Label fx:id="passCountLabel" text="0 PASS" style="-fx-text-fill: #28a745;"/>

        <Separator orientation="VERTICAL"/>

        <Label text="■" style="-fx-text-fill: #856404; -fx-font-size: 14px;"/>
        <Label fx:id="failCountLabel" text="0 FAIL" style="-fx-text-fill: #856404;"/>

        <Separator orientation="VERTICAL"/>

        <Label text="■" style="-fx-text-fill: #721c24; -fx-font-size: 14px;"/>
        <Label fx:id="compileErrorCountLabel" text="0 COMPILE_ERROR" style="-fx-text-fill: #721c24;"/>

        <Separator orientation="VERTICAL"/>

        <Label text="■" style="-fx-text-fill: #c05800; -fx-font-size: 14px;"/>
        <Label fx:id="runtimeErrorCountLabel" text="0 RUNTIME_ERROR" style="-fx-text-fill: #c05800;"/>

        <Separator orientation="VERTICAL"/>

        <Label text="■" style="-fx-text-fill: #6f42c1; -fx-font-size: 14px;"/>
        <Label fx:id="timeoutCountLabel" text="0 TIMEOUT" style="-fx-text-fill: #6f42c1;"/>

        <Region HBox.hgrow="ALWAYS"/>

    </ToolBar>

    <SplitPane dividerPositions="0.55" VBox.vgrow="ALWAYS" orientation="VERTICAL">

        <VBox>
            <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="studentIdColumn"
                                 text="Student ID" prefWidth="130" minWidth="90"/>
                    <TableColumn fx:id="statusColumn"
                                 text="Status" prefWidth="130" minWidth="90"/>
                    <TableColumn fx:id="capturedOutputColumn"
                                 text="Captured Output" prefWidth="280" minWidth="150"/>
                    <TableColumn fx:id="errorMessageColumn"
                                 text="Error / Mismatch Details" prefWidth="250" minWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No results yet. Run the project from the main window."
                           style="-fx-text-fill: #888888;"/>
                </placeholder>
            </TableView>
        </VBox>

        <VBox spacing="10" style="-fx-padding: 12;">

            <Label text="DETAILS"
                   style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #555555;"/>

            <GridPane hgap="16" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="120" prefWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Student ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-text-fill: #777777;"/>
                <Label fx:id="detailStudentId" text="—"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Status:" GridPane.rowIndex="0" GridPane.columnIndex="2"
                       style="-fx-text-fill: #777777;"/>
                <Label fx:id="detailStatus" text="—"
                       GridPane.rowIndex="0" GridPane.columnIndex="3"
                       style="-fx-font-weight: bold;"/>
            </GridPane>

            <SplitPane dividerPositions="0.5">
                <TitledPane text="Captured Output" collapsible="false" maxHeight="Infinity">
                    <ScrollPane fitToWidth="true" fitToHeight="true">
                        <TextArea fx:id="detailCapturedOutput"
                                  editable="false" wrapText="true"
                                  style="-fx-font-family: monospace; -fx-font-size: 11px;"
                                  promptText="(none)"/>
                    </ScrollPane>
                </TitledPane>

                <TitledPane text="Error / Mismatch Details" collapsible="false" maxHeight="Infinity">
                    <ScrollPane fitToWidth="true" fitToHeight="true">
                        <TextArea fx:id="detailErrorMessage"
                                  editable="false" wrapText="true"
                                  style="-fx-font-family: monospace; -fx-font-size: 11px;"
                                  promptText="(none)"/>
                    </ScrollPane>
                </TitledPane>
            </SplitPane>

        </VBox>

    </SplitPane>

    <Separator/>
    <HBox style="-fx-padding: 10 16 10 16;" alignment="CENTER_RIGHT">
        <Button text="Close" defaultButton="true"
                onAction="#onClose"
                style="-fx-font-weight: bold;"/>
    </HBox>

</VBox>
