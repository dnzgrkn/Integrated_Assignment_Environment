<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    project_editor.fxml
    Dialog for creating or editing a Project.
    Maps to: com.iae.model.Project (fields: projectName, activeConfiguration,
             submissionsDirectoryPath, commandLineArguments, expectedOutput)
    Controller: com.iae.gui.dialog.ProjectEditorController 
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.iae.gui.controller.ProjectEditorController"
      prefWidth="520"
      style="-fx-background-color: white;">

    <HBox style="-fx-background-color: #3c3f41; -fx-padding: 12 16 12 16;">
        <Label fx:id="dialogTitleLabel"
               text="New Project"
               style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
    </HBox>

    <VBox spacing="16" style="-fx-padding: 20 20 8 20;" VBox.vgrow="ALWAYS">

        <TitledPane text="Project Details" collapsible="false"
                    style="-fx-font-weight: bold;">
            <GridPane hgap="12" vgap="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <columnConstraints>
                    <ColumnConstraints minWidth="150" prefWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="32" prefWidth="32"/>
                </columnConstraints>

                <Label text="Project Name: *"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="projectNameField"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"
                           GridPane.columnSpan="2"
                           promptText="e.g. CS101 Assignment 3">
                    <tooltip><Tooltip text="A short, descriptive name for this grading session."/></tooltip>
                </TextField>

                <Label text="Configuration: *"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="configurationCombo"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"
                          maxWidth="Infinity" promptText="Select a configuration…">
                    <tooltip><Tooltip text="The compiler/interpreter configuration to use for this project."/></tooltip>
                </ComboBox>
                <Button text="New…"
                        GridPane.rowIndex="1" GridPane.columnIndex="2"
                        onAction="#onNewConfiguration"
                        style="-fx-font-size: 11px;"/>

                <Label text="Submissions Dir: *"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="submissionsDirField"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"
                           promptText="/home/user/submissions">
                    <tooltip><Tooltip text="Folder containing one ZIP file per student."/></tooltip>
                </TextField>
                <Button text="…"
                        GridPane.rowIndex="2" GridPane.columnIndex="2"
                        onAction="#onBrowseSubmissionsDir"/>

                <Label text="CLI Arguments:"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="commandLineArgumentsField"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"
                           GridPane.columnSpan="2"
                           promptText="e.g. input.txt 100">
                    <tooltip><Tooltip text="Arguments passed to each student program at runtime."/></tooltip>
                </TextField>

            </GridPane>
        </TitledPane>

        <TitledPane text="Expected Output" collapsible="false"
                    style="-fx-font-weight: bold;">
            <VBox spacing="6">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <Label text="Paste or type the exact output your program should produce:"
                       style="-fx-text-fill: #555555; -fx-font-size: 11px;"/>

                <TextArea fx:id="expectedOutputArea"
                          prefRowCount="6"
                          wrapText="true"
                          promptText="1&#10;2&#10;3&#10;Fibonacci&#10;…"
                          style="-fx-font-family: monospace; -fx-font-size: 12px;">
                    <tooltip><Tooltip text="The program's stdout will be compared against this text."/></tooltip>
                </TextArea>

                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Button text="Load from file…" onAction="#onLoadExpectedFromFile"
                            style="-fx-font-size: 11px;"/>
                    <Button text="Clear" onAction="#onClearExpected"
                            style="-fx-font-size: 11px;"/>
                </HBox>
            </VBox>
        </TitledPane>

        <Label fx:id="validationLabel"
               style="-fx-text-fill: #cc0000; -fx-font-size: 11px;"
               wrapText="true"/>

    </VBox>

    <Separator/>

    <HBox style="-fx-padding: 12 16 12 16;">
        <Region HBox.hgrow="ALWAYS"/>
        <ButtonBar>
            <buttons>
                <Button fx:id="cancelButton" text="Cancel"
                        cancelButton="true" onAction="#onCancel"/>
                <Button fx:id="saveButton" text="Save Project"
                        defaultButton="true" onAction="#onSave"
                        style="-fx-font-weight: bold;"/>
            </buttons>
        </ButtonBar>
    </HBox>

</VBox>
